<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        نسخه‌ی شب/دارکِ تمِ اصلی - وقتی گوشی رو حالتِ دارکه، اندروید خودکار همینو
        به‌جایِ values/themes.xml انتخاب می‌کنه، بدونِ اینکه به کدِ Kotlin ربطی داشته
        باشه. windowBackground اینجا با پس‌زمینه‌ی تمِ دارکِ خودِ Compose
        (AppDarkColors.background توی Theme.kt) هماهنگه تا قبل از رندرِ اولِ صفحه یا
        پشتِ دیالوگ‌های سیستمی (مثلاً درخواستِ مجوزها) هیچ فلشِ سفیدی دیده نشه.
    -->
    <style name="Theme.SmsApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!--
        پاپ‌آپِ پاسخِ سریع - دیگه ترنسلوسنت نیست، دقیقاً هم‌قاعده‌ی values/themes.xml
        (نگاه کن به کامنتِ اونجا برای دلیل: اکتیویتیِ ترنسلوسنت با showWhenLocked
        رو صفحه‌قفل نمایش داده نمیشه). این کپیِ اینجا قبلاً موقعِ فیکسِ اولیه از قلم
        افتاده بود - وقتی گوشی تو حالتِ دارک/Force Dark بود، اندروید همین نسخه (نه
        نسخه‌ی روشنِ فیکس‌شده) رو انتخاب می‌کرد و باگِ صفحه‌قفل دوباره برمی‌گشت.
    -->
    <style name="Theme.SmsApp.Popup" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#B3000000</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>