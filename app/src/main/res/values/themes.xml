<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        قبلاً این تم همیشه android:Theme.Material.Light بود، حتی وقتی گوشی رو
        دارک بود و تنظیمِ تمِ اپ رو System - windowBackground بومیِ اکتیویتی (که
        قبل از رندرِ اولِ Compose نمایش داده میشه و پشتِ صحنه‌های سیستمی مثل دیالوگِ
        مجوزها هم می‌مونه) همیشه سفید بود و چشم می‌زد. الان یه ورژنِ values-night
        هم داریم (پایین) که با تیره‌بودنِ گوشی هماهنگه.
    -->
    <style name="Theme.SmsApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF7F8FA</item>
    </style>

    <!--
        تمِ اختصاصیِ QuickReplyPopupActivity - پس‌زمینه کاملاً شفافه تا صفحه‌ی واقعی
        (یا صفحه‌قفل) پشتِ کارتِ پاپ‌آپِ Compose دیده بشه، دقیقاً هم‌قاعده‌ی الگوی
        نوتیفِ تماسِ ورودی. خودِ چیدمان/گردیِ کارت از داخلِ QuickReplyPopupScreen میاد.
    -->
    <style name="Theme.SmsApp.Popup" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
